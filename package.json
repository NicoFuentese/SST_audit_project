{
  "name": "sst_audit_project",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p main/tsconfig.json",
    "watch:main": "tsc -p main/tsconfig.json --watch",
    "dev:renderer": "npm run dev --prefix renderer",
    "dev:electron": "wait-on tcp:3000 && electron dist/main/main.js",
    "dev": "npm run build:main && concurrently -k \"npm:watch:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicoFuentese/SST_audit_project.git"
  },
