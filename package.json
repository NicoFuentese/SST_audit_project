  },
  "homepage": "https://github.com/NicoFuentese/SST_audit_project#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "assemblyai": "^4.37.0"
  }
}
